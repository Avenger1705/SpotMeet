<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_forgot_password_root"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/forgot_scroll_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <!-- Back button -->
        <TextView
            android:id="@+id/btn_back_forgot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_outline"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="◁  Back"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Header -->
        <LinearLayout
            android:id="@+id/forgot_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="28dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/img_spotmeet_logo"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Account Recovery"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No worries! Let's get you back in."
                android:textColor="#B0B0CC"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Step 1: Search account card -->
        <LinearLayout
            android:id="@+id/card_search_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="32dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Locate Your Profile"
                android:textColor="#B388FF"
                android:textSize="14sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:lineSpacingExtra="4dp"
                android:text="Enter the email address or username registered to your SpotMeet account so we can find you."
                android:textColor="#8585A3"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Who are we looking for?"
                android:textColor="#B0B0CC"
                android:textSize="15sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_input_focused">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:text="✉️"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/et_forgot_search_email"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="50dp"
                    android:layout_marginEnd="16dp"
                    android:background="@null"
                    android:hint="Enter username or email"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666699"
                    android:textSize="16sp" />
            </RelativeLayout>

            <Button
                android:id="@+id/btn_search_account"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/btn_primary"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="FIND ACCOUNT"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Step 2: Confirm account card (hidden by default) -->
        <LinearLayout
            android:id="@+id/card_confirm_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="32dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secure Verification"
                android:textColor="#B388FF"
                android:textSize="14sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="We found a match for your search!"
                android:textColor="#B0B0CC"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <!-- Masked email display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="✉️"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tv_masked_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_confirm_step_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Enter your full email to confirm"
                android:textColor="#B0B0CC"
                android:textSize="15sp" />

            <RelativeLayout
                android:id="@+id/layout_confirm_email_input"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_input_focused">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:text="✉️"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/et_forgot_confirm_email"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="50dp"
                    android:layout_marginEnd="16dp"
                    android:background="@null"
                    android:hint="Your full email"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666699"
                    android:textSize="16sp" />
            </RelativeLayout>

            <!-- Show full email label (after confirm step) -->
            <TextView
                android:id="@+id/tv_full_email_reveal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="#69FF47"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_send_code"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/btn_primary"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="SEND RESET CODE"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
